// Ground of the first-person arena: realistic ground textures (generated by
// tools/make_ground_textures.gd, one per kind of ground) with normal maps,
// blended between the four nearest overworld tiles along meandering borders
// (see arena_cells.gdshaderinc) so terrain types fade into each other. Each
// texture is also sampled at a larger scale and mixed in, to hide tiling.
// Hot zones glow.
shader_type spatial;

#include "res://shaders/arena_cells.gdshaderinc"

uniform sampler2DArray ground_albedo : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2DArray ground_normal : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
// Per overworld tile id: R = ground texture layer, G = roughness.
uniform sampler2D ground_for : filter_nearest, repeat_disable;
uniform float tile_count = 28.0;
uniform float texture_metres = 4.0; // one repeat of a ground texture
uniform float glow_id = 10.0; // radiation

varying vec3 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	// The ground's texture coordinates run along world x and z.
	TANGENT = normalize(vec3(1.0, 0.0, 0.0) - NORMAL * NORMAL.x);
	BINORMAL = normalize(cross(NORMAL, TANGENT));
}

vec2 ground_info(float id) {
	vec2 info = texture(ground_for, vec2((id + 0.5) / tile_count, 0.5)).rg;
	return vec2(floor(info.r * 255.0 + 0.5), info.g);
}

// Colour (rgb) and roughness (a), plus the normal-map sample, for one tile type.
void ground(float id, vec2 uv, vec2 uv_far, out vec4 albedo, out vec3 normal) {
	vec2 info = ground_info(id);
	vec3 near_c = texture(ground_albedo, vec3(uv, info.x)).rgb;
	vec3 far_c = texture(ground_albedo, vec3(uv_far, info.x)).rgb;
	albedo = vec4(mix(near_c, far_c, 0.35), info.y);
	normal = mix(texture(ground_normal, vec3(uv, info.x)).rgb, texture(ground_normal, vec3(uv_far, info.x)).rgb, 0.3);
}

void fragment() {
	vec2 p = world_pos.xz;
	vec2 uv = p / texture_metres;
	vec2 uv_far = p / (texture_metres * 3.7) + vec2(0.31, 0.77);

	vec4 ids;
	vec2 f;
	arena_cells(p, ids, f);
	vec4 a0; vec4 a1; vec4 a2; vec4 a3;
	vec3 n0; vec3 n1; vec3 n2; vec3 n3;
	ground(ids.x, uv, uv_far, a0, n0);
	ground(ids.y, uv, uv_far, a1, n1);
	ground(ids.z, uv, uv_far, a2, n2);
	ground(ids.w, uv, uv_far, a3, n3);
	vec4 a = mix(mix(a0, a1, f.x), mix(a2, a3, f.x), f.y);
	vec3 n = mix(mix(n0, n1, f.x), mix(n2, n3, f.x), f.y);

	// Broad patches of lighter and darker ground.
	float shade = texture(breakup, p / 140.0 + vec2(0.37, 0.71)).b;
	ALBEDO = a.rgb * (0.85 + 0.3 * shade);
	ROUGHNESS = a.a;
	NORMAL_MAP = n;
	NORMAL_MAP_DEPTH = 1.0;
	EMISSION = vec3(0.2, 1.0, 0.2) * arena_weight(ids, f, glow_id) * (0.25 + 0.2 * sin(TIME * 3.0));
}
